---
import Base from "../layouts/Base.astro";
import Lightbox from "../components/Lightbox.astro";
import Header from "../sections/Header.astro";
import StudentWork from "../sections/StudentWork.astro";
import MyWork from "../sections/MyWork.astro";
import About from "../sections/About.astro";
import Classes from "../sections/Classes.astro";
import News from "../sections/News.astro";
import Contact from "../sections/Contact.astro";
import Footer from "../sections/Footer.astro";
import { getSiteContent } from "../lib/content";

const { site, studentWork, myWork, portrait, news, upcoming, past } =
  await getSiteContent();
const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") === "1";
const about = Astro.url.searchParams.get("about") ?? "";
---

<Base title={site.title} description={site.description} searchable={site.searchable}>
  <Header wordmark={site.wordmark} />
  <StudentWork photos={studentWork} />
  <MyWork photos={myWork} site={site} />
  <About site={site} portrait={portrait} />
  <Classes upcoming={upcoming} past={past} />
  <News items={news} />
  <Contact
    site={site}
    upcoming={upcoming}
    sent={sent}
    error={error}
    about={about}
  />
  <Footer />
  <Lightbox />
</Base>
