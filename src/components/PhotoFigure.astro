---
interface Props {
  id: string;
  caption: string;
  alt: string;
  src: string | null;
  indexLabel: string;
  span?: "3" | "4";
  showNumber?: boolean;
}

const { id, caption, alt, src, indexLabel, span = "3", showNumber = false } = Astro.props;
const label = `Enlarge: ${caption}`;
---

<figure
  class:list={["photo", span === "4" ? "span-4" : "span-3"]}
  data-photo
  data-id={id}
  data-caption={caption}
  data-alt={alt}
  data-src={src ?? ""}
  data-index-label={indexLabel}
  tabindex="0"
  role="button"
  aria-label={label}
>
  <div class="photo-frame">
    {src && <img src={src} alt={alt} width="1500" height="1000" loading="lazy" />}
  </div>
  <figcaption class="photo-caption">
    {showNumber && <span class="photo-num">{indexLabel} </span>}
    {caption}
  </figcaption>
</figure>
