---
import type { SiteSettings } from "../lib/types";

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const [local, domain] = site.email.split("@");
---

<section id="contact" class="section">
  <div class="contact-grid">
    <div>
      <h2 class="section-title">
        <span class="secnum">06</span> Contact
      </h2>
      <a class="contact-email" href={`mailto:${site.email}`}>
        {local}<wbr />@{domain}
      </a>
      <p class="contact-lead">
        For classes, photographs, exhibitions, collaborations, or a conversation about process.
      </p>
    </div>
    <div class="contact-side">
      <div class="contact-base">
        BASED IN CLEVELAND, OH<br />
        TEACHING IN THE REGION<br />
        REPLIES USUALLY WITHIN A WEEK
      </div>
      <div class="contact-links">
        <a href={site.links.instagramEa}>@ETHEREALAPERTUREPHOTO ↗</a>
        <a href={site.links.instagramCara}>@CARAMIAPHOTO ↗</a>
        <a href={site.links.halideUrl}>{site.links.halideLabel}</a>
      </div>
      <p class="contact-note">
        Students: if you'd rather your name appear differently, or not at all, tell me and I'll change it.
      </p>
    </div>
  </div>
</section>
