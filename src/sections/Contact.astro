---
import type { SiteSettings, UpcomingClass } from "../lib/types";

interface Props {
  site: SiteSettings;
  upcoming: UpcomingClass[];
  sent?: boolean;
  error?: boolean;
  about?: string;
}

const { site, upcoming, sent = false, error = false, about = "" } = Astro.props;
const [local, domain] = site.email.split("@");

const general = [
  "A class",
  "Photographs",
  "Exhibition",
  "Collaboration",
  "Process",
  "Something else",
];
const classOptions = upcoming.map((cls) => cls.title);
const interests = [...new Set([...classOptions, ...general])];
const selected =
  about && interests.includes(about)
    ? about
    : about
      ? about
      : "";
---

<section id="contact" class="section">
  <div class="contact-grid">
    <div>
      <h2 class="section-title">
        <span class="secnum">06</span> Contact
      </h2>
      <p class="contact-email">{local}<wbr />@{domain}</p>
      <p class="contact-lead">
        For classes, photographs, exhibitions, collaborations, or a conversation about process.
      </p>
    </div>
    <div class="contact-side">
      <div class="contact-base">
        BASED IN CLEVELAND, OH<br />
        TEACHING IN THE REGION<br />
        REPLIES USUALLY WITHIN A WEEK
      </div>
      <div class="contact-links">
        <a href={site.links.instagramEa}>@ETHEREALAPERTUREPHOTO ↗</a>
        <a href={site.links.instagramCara}>@CARAMIAPHOTO ↗</a>
        <a href={site.links.halideUrl}>{site.links.halideLabel}</a>
      </div>
      <p class="contact-note">
        Students: if you'd rather your name appear differently, or not at all, tell me and I'll change it.
      </p>
    </div>
  </div>

  {sent && (
    <p class="contact-flash" role="status">
      Received. I will write back from this address.
    </p>
  )}
  {error && (
    <p class="contact-flash contact-flash--error" role="alert">
      Something was missing — name, a real email, and a note are required.
    </p>
  )}

  <form class="contact-form" method="post" action="/api/contact">
    <input
      class="hp"
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <input type="hidden" name="source" value={about ? "class" : "site"} />

    <div class="contact-fields">
      <label>
        Name
        <input type="text" name="name" required maxlength="120" autocomplete="name" />
      </label>
      <label>
        Email
        <input type="email" name="email" required maxlength="200" autocomplete="email" />
      </label>
      <label>
        Phone <span class="optional">optional</span>
        <input type="tel" name="phone" maxlength="40" autocomplete="tel" />
      </label>
      <label>
        About
        <select name="interest">
          <option value="" disabled selected={!selected}>Choose one</option>
          {about && !interests.includes(about) && (
            <option value={about} selected>{about}</option>
          )}
          {interests.map((item) => (
            <option value={item} selected={item === selected}>{item}</option>
          ))}
        </select>
      </label>
    </div>
    <label>
      Message
      <textarea name="message" required maxlength="4000" rows="6"></textarea>
    </label>
    <div class="contact-actions">
      <button type="submit">Send</button>
    </div>
  </form>
</section>
