---
import type { ClassStatus, PastClass, UpcomingClass } from "../lib/types";

interface Props {
  upcoming: UpcomingClass[];
  past: PastClass[];
}

const { upcoming, past } = Astro.props;

const statusCopy: Record<ClassStatus, string> = {
  "registration-open": "● Registration open",
  waitlist: "Waitlist",
  "coming-soon": "Coming soon",
  full: "Full",
  completed: "Completed",
};

const meta = (cls: UpcomingClass) =>
  [
    ["DATES", cls.dates],
    ["TIME", cls.time],
    ["WHERE", cls.where],
    ["LEVEL", cls.level],
    ["BRING", cls.bring],
    ["COST", cls.cost],
  ].filter(([, value]) => Boolean(value));

---

<section id="classes" class="section">
  <div class="section-head">
    <h2 class="section-title">
      <span class="secnum">04</span> Classes
    </h2>
    <p class="section-note">
      Small groups. No experience assumed unless the listing says so. Write if a class is full — I keep a list.
    </p>
  </div>

  <h3 class="subhead">Upcoming</h3>
  {upcoming.map((cls) => (
    <article class="class-entry">
      <div class="class-copy">
        <h4>{cls.title}</h4>
        <p>{cls.description}</p>
      </div>
      <dl class="class-meta">
        {meta(cls).map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="class-cta">
        <span class:list={["status", cls.status === "registration-open" && "status--open"]}>
          {statusCopy[cls.status]}
        </span>
        {/^https?:\/\//.test(cls.ctaHref) ? (
          <a href={cls.ctaHref}>{cls.ctaLabel}</a>
        ) : (
          <a href="#contact" data-write data-about={cls.title}>{cls.ctaLabel}</a>
        )}
      </div>
    </article>
  ))}

  <h3 class="subhead subhead--past">Past</h3>
  <ul class="past-list">
    {past.map((cls) => (
      <li class="past-row">
        <span class="past-term">{cls.term}</span>
        <span>{cls.title}</span>
        <span class="past-note">{cls.note}</span>
        <a class="row-link" href={cls.photosHref}>Photographs →</a>
      </li>
    ))}
  </ul>
</section>
