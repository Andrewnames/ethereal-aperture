---
import PhotoFigure from "../components/PhotoFigure.astro";
import type { Photo } from "../lib/types";

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<section id="student-work" class="section">
  <div class="section-head">
    <h2 class="section-title">
      <span class="secnum">01</span> Student work
    </h2>
    <p class="section-note">
      A selection pulled from classes. Photographs published with permission. Click any frame to enlarge.
    </p>
  </div>

  <div class="gallery gallery--students">
    {photos.map((photo) => (
      <PhotoFigure
        id={photo.id}
        caption={photo.caption}
        alt={photo.alt}
        src={photo.src}
        indexLabel={photo.indexLabel}
        span="3"
        showNumber={true}
      />
    ))}
  </div>
</section>
